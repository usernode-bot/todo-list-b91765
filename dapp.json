{
  "icon": {
    "emoji": "📝"
  },
  "secrets": [],
  "tests": [
    {
      "name": "App shell loads",
      "path": "/",
      "expectSelector": "#app"
    },
    {
      "name": "Native kit boots",
      "path": "/",
      "expectSelector": "html.un-ios, html.un-android, html.un-desktop"
    },
    {
      "name": "Shared list counts the owner in its member count",
      "path": "/",
      "expectText": "2 members"
    },
    {
      "name": "Home shows shared-list activity",
      "path": "/",
      "expectText": "staging-demo-user checked"
    },
    {
      "name": "Landing page renders the demo list on the shared theme",
      "path": "/landing.html",
      "expectSelector": ".un-group .todo-check",
      "expectText": "Create your account"
    },
    {
      "name": "Search clear button renders as a large touch target",
      "path": "/?shot=search",
      "expectSelector": "#search-clear.un-touch-target:not(.hidden)"
    },
    {
      "name": "Import modal is capped to the card, not the viewport",
      "path": "/?shot=import",
      "expectSelector": ".un-modal.modal-wide .modal-card.md-body #md-text",
      "expectText": "Import markdown"
    },
    {
      "name": "Members modal is capped to the card, not the viewport",
      "path": "/?shot=members",
      "expectSelector": ".un-modal.modal-narrow .modal-card #members-body",
      "expectText": "Members"
    },
    {
      "name": "The invite box offers autocomplete instead of a free-text field",
      "path": "/?shot=members",
      "expectSelector": "#members-body form #invite-input[role=combobox] + #invite-suggest[role=listbox]",
      "expectText": "You can only invite people who’ve used Todo List"
    },
    {
      "name": "The invite typeahead lists the usernames it matched",
      "path": "/?shot=invite",
      "expectSelector": "#invite-suggest[role=listbox]:not(.hidden) li[role=option]",
      "expectText": "@staging-demo"
    },
    {
      "name": "Offline status strip renders",
      "path": "/?shot=offline",
      "expectSelector": "#offline-chip",
      "expectText": "showing saved copy"
    },
    {
      "name": "Syncing status strip renders",
      "path": "/?shot=syncing",
      "expectSelector": "#offline-chip",
      "expectText": "Syncing 2 changes"
    },
    {
      "name": "First load renders skeleton placeholders, not a spinner",
      "path": "/?shot=loading",
      "expectSelector": "#app .sk"
    },
    {
      "name": "A row waiting to sync shows its pending marker",
      "path": "/?shot=pending",
      "expectSelector": ".item-row [data-pending-dot]"
    },
    {
      "name": "Slow-connection status strip renders",
      "path": "/?shot=slow",
      "expectSelector": "#offline-chip",
      "expectText": "Slow connection"
    },
    {
      "name": "An empty category offers a tappable way to add the first item",
      "path": "/?shot=empty",
      "expectSelector": "button.empty-note.un-touch-target",
      "expectText": "No items yet"
    },
    {
      "name": "Undo is available in the list header after a change",
      "path": "/?shot=undo",
      "expectSelector": "#undo-btn[aria-disabled=false]:not([disabled])"
    },
    {
      "name": "A list with due dates on shows a due chip per item",
      "path": "/?shot=due",
      "expectSelector": ".item-row .due-chip[data-due]",
      "expectText": "Today"
    },
    {
      "name": "The due-date editor opens on the phone-width card",
      "path": "/?shot=dueeditor",
      "expectSelector": ".un-modal.modal-narrow .modal-card#due-editor #due-date-input",
      "expectText": "Due date"
    },
    {
      "name": "A todo row's checkbox carries its own enlarged hit target",
      "path": "/?shot=collapsed",
      "expectSelector": ".item-row label.check-hit .todo-check"
    },
    {
      "name": "Category headers offer an explicit rename control",
      "path": "/?shot=collapsed",
      "expectSelector": ".cat-head button.cat-rename"
    },
    {
      "name": "The category name is the collapse control",
      "path": "/?shot=collapsed",
      "expectSelector": ".cat-head button.cat-toggle[aria-expanded=true] .un-group-header"
    },
    {
      "name": "A collapsed category hides its items and counts them instead",
      "path": "/?shot=collapsed",
      "expectSelector": ".cat-head .cat-toggle[aria-expanded=false] ~ .cat-count",
      "expectText": "items"
    },
    {
      "name": "The offline and storage read-out renders",
      "path": "/?shot=diag",
      "expectSelector": ".un-modal.modal-narrow .modal-card #diag-body",
      "expectText": "Saved for offline"
    },
    {
      "name": "A device that refuses offline storage gets honest strip copy",
      "path": "/?shot=nostore",
      "expectSelector": "#offline-chip:not(.hidden)",
      "expectText": "changes will be lost"
    }
  ],
  "visibility": {
    "build": "private",
    "view": "public"
  },
  "admins": [
    "evan"
  ]
}
